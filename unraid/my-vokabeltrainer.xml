<?xml version="1.0"?>
<Container version="2">
  <Name>vokabeltrainer</Name>
  <Repository>ghcr.io/dfechner1980-png/vokabeltrainer:latest</Repository>
  <Registry>https://github.com/dfechner1980-png/vokabeltrainer/pkgs/container/vokabeltrainer</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Overview>Vokabeltrainer für zu Hause: Deutsch vorgeben, Englisch eintippen, Fehler buchstabengenau anzeigen, falsche Wörter wiederholen.</Overview>
  <Category>Tools:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <Icon/>
  <ExtraParams/>
  <Config Name="WebUI-Port" Target="8080" Default="8080" Mode="tcp" Description="Port der Weboberfläche" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Daten" Target="/data" Default="/mnt/user/appdata/vokabeltrainer" Mode="rw" Description="Datenbank mit Vokabeln und Statistik" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/vokabeltrainer</Config>
  <Config Name="Admin-PIN" Target="ADMIN_PIN" Default="" Mode="" Description="PIN für den Bereich Verwalten (leer = keine PIN)" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Groß-/Kleinschreibung prüfen" Target="CASE_SENSITIVE" Default="false" Mode="" Description="true = Schreibweise muss exakt stimmen" Type="Variable" Display="always" Required="false" Mask="false">false</Config>
  <Config Name="Zeitzone" Target="TZ" Default="Europe/Berlin" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">Europe/Berlin</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">100</Config>
</Container>
